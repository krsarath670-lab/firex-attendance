# FIREX Attendance — Production Environment Variables
NODE_ENV=production
PORT=5050

# Security & Session Token Secret (Change in Production)
JWT_SECRET=firex-attendance-production-super-secret-key-2026-secure

# Default Operating Timezone
TIMEZONE=Asia/Bahrain

# Optional External Cloud PostgreSQL Database Connection (Supabase / Render / Neon / AWS RDS)
# If left empty, system uses high-performance zero-config atomic transactional database with auto-backups.
# DATABASE_URL=postgresql://postgres:password@host:5432/firex_attendance
